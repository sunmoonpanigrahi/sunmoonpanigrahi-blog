---
// Dusk landscape banner: a sun setting behind blue mountains while the moon rises.
interface Props {
	title: string;
	subtitle?: string;
}

const { title, subtitle } = Astro.props;

// Fixed star positions (x, y, radius) so the sky looks the same on every build.
const stars = [
	[60, 40, 1.4], [140, 120, 1], [210, 60, 1.8], [300, 180, 1.1], [360, 30, 1.2],
	[430, 110, 1.6], [500, 200, 1], [560, 50, 1.3], [640, 150, 1.1], [700, 20, 1.7],
	[760, 90, 1], [830, 190, 1.4], [890, 40, 1.1], [950, 130, 1.8], [1020, 70, 1],
	[1080, 170, 1.3], [1140, 30, 1.5], [1180, 110, 1], [100, 220, 1], [1000, 230, 1.1],
	[260, 240, 0.9], [600, 240, 0.9], [880, 245, 1], [400, 230, 0.8],
];
---

<section class="hero">
	<svg class="stars" viewBox="0 0 1200 260" preserveAspectRatio="xMidYMin slice" aria-hidden="true">
		{
			stars.map(([cx, cy, r], i) => (
				<circle cx={cx} cy={cy} r={r} class={i % 3 === 0 ? 'twinkle' : ''} style={`animation-delay: ${(i % 5) * 0.7}s`} />
			))
		}
	</svg>

	<svg class="moon" viewBox="0 0 100 100" aria-hidden="true">
		<defs>
			<mask id="crescent">
				<rect width="100" height="100" fill="white"></rect>
				<circle cx="66" cy="38" r="36" fill="black"></circle>
			</mask>
		</defs>
		<circle cx="50" cy="50" r="40" fill="#fef3c7" mask="url(#crescent)"></circle>
	</svg>

	<div class="hero-text">
		<h1>{title}</h1>
		{subtitle && <p>{subtitle}</p>}
	</div>

	<svg class="landscape" viewBox="0 0 1200 200" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
		<circle class="sun" cx="600" cy="105" r="72"></circle>
		<path
			class="ridge-back"
			d="M0 100 L80 60 L160 85 L250 40 L330 75 L420 45 L500 95 L560 120 L640 125 L700 90 L780 50 L860 80 L950 35 L1030 70 L1110 45 L1200 65 V200 H0 Z"
		></path>
		<path
			class="ridge-mid"
			d="M0 130 L100 95 L190 125 L290 85 L380 130 L470 110 L560 150 L650 145 L740 115 L830 140 L920 95 L1010 130 L1100 100 L1200 120 V200 H0 Z"
		></path>
		<path class="ridge-front" d="M0 170 Q150 130 300 165 T600 160 T900 155 T1200 162 V200 H0 Z"></path>
	</svg>
</section>

<style>
	.hero {
		--landscape-height: clamp(140px, 16vw, 300px);
		position: relative;
		overflow: hidden;
		color: #fff;
		background:
			radial-gradient(ellipse 45% 40% at 50% 100%, rgba(253, 186, 116, 0.95), transparent 70%),
			linear-gradient(
				180deg,
				var(--navy) 0%,
				#1e40af 40%,
				#3b82f6 62%,
				#fdba74 86%,
				var(--orange) 100%
			);
	}
	.stars {
		position: absolute;
		inset: 0 0 auto 0;
		width: 100%;
		height: 55%;
		fill: #fff;
		opacity: 0.85;
	}
	.twinkle {
		animation: twinkle 3.5s ease-in-out infinite;
	}
	@keyframes twinkle {
		50% {
			opacity: 0.25;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.twinkle {
			animation: none;
		}
	}
	.moon {
		position: absolute;
		top: clamp(16px, 4vw, 40px);
		right: 6%;
		width: clamp(44px, 7vw, 84px);
		height: auto;
		filter: drop-shadow(0 0 12px rgba(254, 243, 199, 0.7));
	}
	.hero-text {
		position: relative;
		width: 720px;
		max-width: calc(100% - 2em);
		margin: 0 auto;
		padding: 3em 1em calc(var(--landscape-height) + 1em);
		box-sizing: border-box;
		text-shadow: 0 2px 14px rgba(11, 42, 91, 0.55);
	}
	.hero-text h1 {
		color: #fff;
	}
	.hero-text p {
		margin: 0;
		color: #e0ecff;
		font-size: 1.1em;
	}
	.landscape {
		position: absolute;
		left: 0;
		bottom: 0;
		display: block;
		width: 100%;
		height: var(--landscape-height);
	}
	.sun {
		fill: #fb923c;
		filter: drop-shadow(0 0 24px rgba(253, 186, 116, 0.9));
	}
	.ridge-back {
		fill: #3b5cb8;
	}
	.ridge-mid {
		fill: #1e3a8a;
	}
	.ridge-front {
		fill: var(--navy);
	}
	@media (max-width: 720px) {
		.hero-text {
			padding-top: 2em;
			max-width: 100%;
			width: 100%;
			padding-right: 4.5em;
		}
		.hero-text h1 {
			font-size: 2.4em;
		}
	}
</style>
