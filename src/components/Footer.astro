---
import { SITE_TITLE } from '../consts';

const today = new Date();
---

<footer>
	&copy; {today.getFullYear()} {SITE_TITLE}. All rights reserved.
</footer>
<style>
	footer {
		padding: 2em 1em 6em 1em;
		background: var(--navy);
		border-top: 3px solid var(--orange);
		color: #fff;
		text-align: center;
	}
</style>
